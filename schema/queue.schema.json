{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upgrade-audit walk queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from_version",
    "to_version",
    "ids"
  ],
  "properties": {
    "from_version": {
      "type": "string",
      "minLength": 1
    },
    "to_version": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
